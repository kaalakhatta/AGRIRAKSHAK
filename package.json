{
  "name": "agrirakshak",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@agrirakshak/web",
    "exhibition": "node scripts/start-exhibition.mjs",
    "build": "npm run build --workspace=@agrirakshak/web",
    "lint": "npm run lint --workspace=@agrirakshak/web",
    "typecheck": "npm run typecheck --workspace=@agrirakshak/web",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test": "npm run test --workspace=@agrirakshak/web"
  }
}
